# =============================================================================
# Batter Configuration
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Then generate a JWT secret:
#   openssl rand -hex 32
# =============================================================================

# REQUIRED: Secret for signing JWT tokens (generate with: openssl rand -hex 32)
JWT_SECRET=

# Database credentials (change in production)
POSTGRES_USER=batter
POSTGRES_PASSWORD=batter
POSTGRES_DB=batter

# Port the app is accessible on (default: 3000)
# BATTER_PORT=3000

# If accessing Batter from a different host/port, set these:
# ALLOWED_ORIGINS=http://192.168.1.100:3000
# FRONTEND_URL=http://192.168.1.100:3000
