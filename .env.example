# Server
PORT=8080
HOST=0.0.0.0

# Database
DATABASE_URL=postgres://batter:batter@localhost:5432/batter?sslmode=disable

# Device
SCRCPY_SERVER_PATH=/usr/local/share/scrcpy/scrcpy-server
SCRCPY_VERSION=3.3.4

# Auth
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRY_SECS=3600

# CORS (comma-separated origins, empty = localhost only)
ALLOWED_ORIGINS=

# Frontend
FRONTEND_URL=http://localhost:3000
